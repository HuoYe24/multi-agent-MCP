# LLM: OpenAI-compatible chat API
LLM_MODEL=qwen-max-0919
LLM_TEMPERATURE=0
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# Embedding / retrieval
DENSE_MODEL=nomic-embed-text
SPARSE_MODEL=Qdrant/bm25
OLLAMA_HOST=http://127.0.0.1:11434
RERANKER_TYPE=cross_encoder
CROSS_ENCODER_RERANKER_MODEL=BAAI/bge-reranker-base

# App
APP_HOST=127.0.0.1
APP_PORT=7860
APP_AUTO_RELOAD=true

# Redis short-term memory
REDIS_URL=redis://localhost:6379/0
SHORT_TERM_MEMORY_TTL_SECONDS=1800
SHORT_TERM_MEMORY_MAX_TURNS=20

# MCP tool server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8765
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_CLIENT_TIMEOUT_SECONDS=3

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=multi-agent-mcp-app
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=false

# Optional PDF parser
LLAMA_CLOUD_API_KEY=

# E-commerce demo
ECOMMERCE_DEFAULT_STORE_NAME=Demo Store

# GraphRAG
GRAPH_RAG_ENABLED=true
GRAPH_RAG_MAX_RESULTS=8
